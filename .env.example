# Supercell API token. Server-side only.
# Never rename this with a VITE_ prefix — that would inline it into the browser bundle.
CR_API_TOKEN=

# All API traffic goes through the RoyaleAPI proxy, which has stable egress IPs.
# Never hardcode api.clashroyale.com anywhere in the source.
CR_API_BASE_URL=https://proxy.royaleapi.dev/v1
