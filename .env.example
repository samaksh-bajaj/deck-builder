# Supercell API token. Server-side only.
# Never rename this with a VITE_ prefix — that would inline it into the browser bundle.
CR_API_TOKEN=

# All API traffic goes through the RoyaleAPI proxy, which has stable egress IPs.
# Never hardcode api.clashroyale.com anywhere in the source.
CR_API_BASE_URL=https://proxy.royaleapi.dev/v1

# Optional. Requests per second, enforced globally by shared/crClient.ts.
# 5 is Supercell's ceiling, so this is a knob for tuning down — e.g. if the
# crawler starts seeing sustained 429s. Leave unset to get 5.
CR_MAX_REQUESTS_PER_SECOND=

# Optional. Retries after the first attempt, for 429/5xx/transport failures
# only — never for a 403, where retrying just delays a clear message. Kept low
# by default because api/best-deck.ts shares the client and a user is waiting
# on it. Set to 0 to disable retrying. Leave unset to get 2.
CR_MAX_RETRIES=
